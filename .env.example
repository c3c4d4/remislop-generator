CELERY_TASK_ALWAYS_EAGER=true
LOCAL_BACKGROUND_JOBS=true
OUTPUT_DIRECTORY=downloaded_images
CACHE_DIRECTORY=.cache/media
DATABASE_PATH=instance/jobs.sqlite3
MAX_IMAGES=80
MIN_IMAGES=8
MAX_DURATION_SECONDS=3600
DEFAULT_FRAME_RATE=10
CLEANUP_AFTER_SECONDS=86400
WATERMARK_SIZE=196
WATERMARK_MARGIN=48
WATERMARK_SOURCE_PATH=assets/watermarks/black.png
MAX_OUTPUT_MB=9.5
MIN_VIDEO_BITRATE_KBPS=45
MAX_AUDIO_BITRATE_KBPS=64
